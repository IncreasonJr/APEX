# NVIDIA NIM API Key (Required)
# Get yours from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA NIM Base API URL (Optional, defaults to official integrate endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default Model for general queries (Optional, defaults to meta/llama-4-maverick-17b-128e-instruct)
DEFAULT_MODEL=meta/llama-4-maverick-17b-128e-instruct

# Tavily API Key for Web Search (Optional, free tier available at app.tavily.com)
TAVILY_API_KEY=your-tavily-key

# Safe Sandbox Code Execution Enabled (Optional, defaults to true)
CODE_EXECUTION_ENABLED=true
